{
  "name": "flow",
  "version": "3.6.4",
  "description": "Music player for songs downloaded from YouTube, SoundCloud, Vimeo and more",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux -c.directories.output=../linux-client/dist -c.extraMetadata.homepage=https://github.com/Ceeser1/Flow"
  },
  "dependencies": {
    "@flow/core": "*"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.ceeser.flow",
    "npmRebuild": false,
    "productName": "Flow",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "images/*.png",
      "images/*.jpg"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Audio",
      "maintainer": "Ceeser",
      "extraResources": [
        {
          "from": "tools",
          "to": "tools",
          "filter": [
            "ffmpeg",
            "ffprobe"
          ]
        },
        {
          "from": "build/icon.png",
          "to": "icon.png"
        }
      ]
    },
    "deb": {
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Flow",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  },
  "author": "Ceeser",
  "license": "MIT"
}
